# === New-machine setup (copy this file to .env, never commit .env) ===
# 1. YOUR keys (from your own accounts):
#      INNKUBE_API_KEY = your personal InnKube key below.
#      LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY come later from step 4.
# 2. MACHINE secrets (generate fresh per machine with e.g.
#    `openssl rand -hex 16` — never copy another machine's .env):
#      POSTGRES_PASSWORD, CLICKHOUSE_PASSWORD, REDIS_AUTH,
#      NEXTAUTH_SECRET + SALT (`openssl rand -base64 32`),
#      ENCRYPTION_KEY (`openssl rand -hex 32` — exactly 64 hex chars, required).
# 3. VALUES THAT MUST MATCH (the only cross-field traps):
#      MINIO_ROOT_PASSWORD == all three LANGFUSE_S3_*_SECRET_ACCESS_KEYs.
#      DATABASE_URL = postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
# 4. Boot infra first, then the app tier (recreate, not restart, after edits):
#      docker compose up -d postgres redis clickhouse minio   # wait healthy
#      docker compose up -d langfuse-web langfuse-worker prometheus
#    Open http://localhost:3000 -> sign up -> org -> project ->
#    project Settings -> API keys -> backfill LANGFUSE_PUBLIC_KEY/SECRET_KEY.
#    Then: docker compose up provision-dashboard  (creates the Studymate
#    Dashboard — the scoped boots above never start that one-shot service).
# 5. Assistant (optional): fill the LANGFUSE_AI_* block below (Innkube
#    example in its comment), set LANGFUSE_IN_APP_AGENT_ENABLED=true,
#    recreate web+worker, then org Settings -> AI Features.
#
# InnKube LLM Inference API Key (Provided by Bagus)
# This ONE key must be granted all three models: qwen-agentworld-35b-a3b
# (chat), octen-embedding-8b (semantic recall), qwen3-reranker-4b (reorder).
INNKUBE_API_KEY=your_innkube_api_key_here

# Environment configuration
STUDY_AGENT_ENV=development
LOG_LEVEL=INFO

# Opt-in dedicated terminal window on `studymate` launch (default: same terminal).
LAUNCH_NEW_TERMINAL=FALSE

# Observability (Week 3 Task 1) — all off by default; enable to expose
# Prometheus metrics on 127.0.0.1:8000 and write ./observability/traces.jsonl.
STUDYMATE_METRICS_ENABLED=FALSE
STUDYMATE_METRICS_HOST=127.0.0.1
STUDYMATE_METRICS_PORT=8000
STUDYMATE_TRACE_MAX_CHARS=4000
LANGFUSE_ENABLED=FALSE
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# MCP health heartbeat — all off by default. When enabled, a background
# prober checks the MCP servers every interval and reports to BOTH
# Prometheus gauges (studymate_mcp_up) and Langfuse heartbeat traces
# (mcp-health:* observations for the status widget).
STUDYMATE_HEALTH_ENABLED=FALSE
STUDYMATE_HEALTH_INTERVAL_SECONDS=60

# Langfuse self-host infra secrets (compose only; generate per machine,
# e.g. `openssl rand -hex 32` for ENCRYPTION_KEY — never commit real values).
# NOTE: MinIO root password must equal the three LANGFUSE_S3_*_SECRET keys
# (S3 is mandatory for v4 trace ingestion: web -> S3 -> worker -> ClickHouse),
# and DATABASE_URL must embed POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
DATABASE_URL=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# Self-hosted Langfuse Assistant (in-app agent) — all off/empty by default.
# Set these (then recreate web+worker) plus org Settings -> AI Features.
# InnKube example: PROVIDER=openai MODEL=qwen3-next-80b-a3b-instruct
# (qwen-agentworld-35b-a3b rejects the Assistant's message shape with 400,
# verified live; keep it for StudyMate itself, not the Assistant)
# API_KEY=<same INNKUBE_API_KEY as above>
# BASE_URL=https://llms.innkube.fim.uni-passau.de/v1 (the /v1 matters).
# Worker reaches MCP via the compose service name by default.
LANGFUSE_AI_PROVIDER=openai
LANGFUSE_AI_MODEL=qwen3-next-80b-a3b-instruct
LANGFUSE_AI_SMALL_MODEL=
LANGFUSE_AI_API_KEY=
LANGFUSE_AI_BASE_URL=https://llms.innkube.fim.uni-passau.de/v1
LANGFUSE_IN_APP_AGENT_ENABLED=true
LANGFUSE_MCP_BASE_URL=http://langfuse-web:3000
LANGFUSE_MCP_ALLOWED_HOSTS=langfuse-web
