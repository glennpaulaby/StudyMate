# InnKube LLM Inference API Key (Provided by Bagus)
# This ONE key must be granted all three models: qwen-agentworld-35b-a3b
# (chat), octen-embedding-8b (semantic recall), qwen3-reranker-4b (reorder).
INNKUBE_API_KEY=your_innkube_api_key_here

# Environment configuration
STUDY_AGENT_ENV=development
LOG_LEVEL=INFO

# Opt-in dedicated terminal window on `studymate` launch (default: same terminal).
LAUNCH_NEW_TERMINAL=FALSE

# Observability (Week 3 Task 1) — all off by default; enable to expose
# Prometheus metrics on 127.0.0.1:8000 and write ./observability/traces.jsonl.
STUDYMATE_METRICS_ENABLED=FALSE
STUDYMATE_METRICS_HOST=127.0.0.1
STUDYMATE_METRICS_PORT=8000
STUDYMATE_TRACE_MAX_CHARS=4000
LANGFUSE_ENABLED=FALSE
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse self-host infra secrets (compose only; generate per machine,
# e.g. `openssl rand -hex 32` for ENCRYPTION_KEY — never commit real values).
# NOTE: MinIO root password must equal the three LANGFUSE_S3_*_SECRET keys
# (S3 is mandatory for v4 trace ingestion: web -> S3 -> worker -> ClickHouse),
# and DATABASE_URL must embed POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
DATABASE_URL=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=

# Self-hosted Langfuse Assistant (in-app agent) — all off/empty by default.
# Set these (then recreate web+worker) plus org Settings -> AI Features.
# InnKube example: PROVIDER=openai MODEL=qwen-agentworld-35b-a3b
# API_KEY=<same INNKUBE_API_KEY as above>
# BASE_URL=https://llms.innkube.fim.uni-passau.de/v1 (the /v1 matters).
# Worker reaches MCP via the compose service name by default.
LANGFUSE_AI_PROVIDER=
LANGFUSE_AI_MODEL=
LANGFUSE_AI_SMALL_MODEL=
LANGFUSE_AI_API_KEY=
LANGFUSE_AI_BASE_URL=
LANGFUSE_IN_APP_AGENT_ENABLED=false
LANGFUSE_MCP_BASE_URL=http://langfuse-web:3000
LANGFUSE_MCP_ALLOWED_HOSTS=langfuse-web
